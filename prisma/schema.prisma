// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
  previewFeatures = []
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  products      Product[]
  brandManagers BrandManager[] // One-to-many relationship with BrandManager
  orders        Order[] // One-to-many relationship with Order
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(BUYER)

  // Relationships
  brandManagers BrandManager[] // One-to-many relationship with BrandManager
  buyerOrders   Order[]        @relation("BuyerOrders")
  
  // User settings - one-to-one relationship
  settings      UserSettings?
}

// User Settings model
model UserSettings {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Common settings
  darkMode                Boolean  @default(false)
  emailNotifications      Boolean  @default(true)
  language                String   @default("en")
  showProfile             Boolean  @default(true)
  showEmail               Boolean  @default(false)
  primaryColor            String   @default("#7C3AED")
  
  // Buyer-specific settings
  upiId                   String?  // UPI ID for payments (optional)
  showOrderHistory        Boolean  @default(true)
  defaultPaymentMethod    String?  // Payment method preference
  orderStatusNotifications Boolean  @default(true)
  
  // Mediator-specific settings
  disputeNotifications    Boolean  @default(true)
  autoAssignDisputes      Boolean  @default(false)
  disputeResponseTime     String?  // Response time preference (e.g., "24h")
  mediatorBio             String?  @db.Text // Mediator description
  
  // Admin-specific settings
  adminDashboardView      String?  // Default dashboard view
  enableAdvancedFeatures  Boolean  @default(false)
  logsRetentionDays       Int?     // How long to keep logs
  systemAlerts            Boolean  @default(true)
  
  // Additional settings as JSON
  additionalSettings      Json?    // For extensibility
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Application logs for system monitoring and debugging
model AppLog {
  id        Int      @id @default(autoincrement())
  level     LogLevel @default(INFO)
  message   String   @db.Text
  source    String?  // Which part of the application generated this log
  userId    Int?     // Optional user ID if the log is related to a user action
  metadata  Json?    // Additional structured data related to the log
  createdAt DateTime @default(now())
  
  @@index([level])
  @@index([source])
  @@index([createdAt])
}

// Explicit join model for Brand and Manager relationship
model BrandManager {
  id      Int @id @default(autoincrement())
  brandId Int
  userId  Int

  // Relations
  brand    Brand     @relation(fields: [brandId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  products Product[]
  orders   Order[] // One-to-many relationship with Order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint to prevent duplicate brand-manager pairs
  @@unique([brandId, userId])
}

model Order {
  id             Int      @id @default(autoincrement())
  orderId        String   @unique
  dateOfOrder    DateTime
  buyerId        Int
  brandId        Int
  brandManagerId Int

  // Relations
  buyer        User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  brand        Brand        @relation(fields: [brandId], references: [id])
  brandManager BrandManager @relation(fields: [brandManagerId], references: [id])

  // Many-to-many relationship with Product using explicit join model
  orderProducts OrderProduct[]
  
  // One-to-many relationship with OrderScreenshot
  orderScreenshots OrderScreenshot[]

  // Order metadata
  dealType         DealType? // Optional order-level deal type
  campaignType     CampaignType? // Optional order-level campaign type
  commission       Float? // Optional commission amount
  exchangeNotes    String? // Notes for exchange orders
  orderProofStatus OrderProofStatus @default(SUBMITTED)
  
  // Only store UPI ID for payment
  upiId            String?  // UPI ID used for this order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id        Int    @id @default(autoincrement())
  name      String
  brandId   Int
  managerId Int    @default(1)

  // Relations
  brand   Brand        @relation(fields: [brandId], references: [id])
  manager BrandManager @relation(fields: [managerId], references: [id])

  // Many-to-many relationship with Order using explicit join model
  orderProducts OrderProduct[]
  
  // One-to-many relationship with OrderScreenshot
  orderScreenshots OrderScreenshot[]

  // Product metadata
  dealType      DealType
  campaignType  CampaignType
  commission    Float?
  exchangeNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Explicit join model for Order-Product many-to-many relationship
model OrderProduct {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  // Ensure each product appears only once per order
  @@unique([orderId, productId])
}

// Model to store order screenshots
model OrderScreenshot {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int
  screenshotUrl String   // Path to the screenshot image
  createdAt     DateTime @default(now())

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Ensure each product has only one screenshot per order
  @@unique([orderId, productId])
}

enum Role {
  BUYER
  MEDIATOR
  SELLER
  ADMIN
}

enum DealType {
  ORIGINAL
  EMPTY
  EXCHANGE
}

enum CampaignType {
  RATING_DEAL
  REVIEW_DEAL
  ORDER_ONLY_DEAL
}

enum OrderProofStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum LogLevel {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}
